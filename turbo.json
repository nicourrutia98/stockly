{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^dev"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", "target/**/*.jar"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "target/site/jacoco/**", "target/pit-reports/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}