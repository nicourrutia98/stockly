<?xml version="1.0" encoding="UTF-8"?>
<!--
    0004 — Create the `users` table for the auth module (T6).

    Column → User.java mapping:
        id            BIGINT GENERATED BY DEFAULT AS IDENTITY  (User.id, @Id)
        email         VARCHAR(254) NOT NULL                     (User.email, RFC 5321 max)
        password_hash VARCHAR(72)  NOT NULL                     (User.passwordHash, bcrypt max)
        role          VARCHAR(32)  NOT NULL                     (User.role, enum ROLE_USER / ROLE_ADMIN)
        active        BOOLEAN      NOT NULL DEFAULT TRUE        (User.active)
        version       BIGINT       NOT NULL DEFAULT 0           (User.version, optimistic lock)
        created_at    TIMESTAMP WITH TIME ZONE NOT NULL         (User.createdAt, @CreatedDate)
        updated_at    TIMESTAMP WITH TIME ZONE NOT NULL         (User.updatedAt, @LastModifiedDate)

    Notes:
        - email is stored as VARCHAR(254) per RFC 5321 §4.5.3.1 (max email length).
          Emails are canonicalised to lowercase by the application layer.
        - password_hash is bounded to 72 chars (bcrypt's maximum output length;
          BCryptPasswordEncoder silently truncates any input beyond 72 bytes).
        - role is stored as VARCHAR (not a native ENUM) so adding a new role
          does not require an ALTER TYPE migration.
        - UNIQUE(email) is enforced by a unique constraint on this table;
          0005 adds a case-insensitive functional index so look-ups are fast
          even if the canonical lowercase invariant is broken at the storage
          layer.
        - There is no UNIQUE on email at the column level in this changeset
          because @UniqueConstraint on User.java is mapped to a constraint
          named uk_users_email — this changeset uses the same name so
          Hibernate's ddl-auto=validate agrees with Liquibase.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="0004-create-users-table" author="stockly">
        <comment>Create the `users` table for the auth aggregate (T6).</comment>

        <createTable tableName="users">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(254)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(72)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(32)" defaultValue="ROLE_USER">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="users"
                columnNames="email"
                constraintName="uk_users_email"/>
    </changeSet>
</databaseChangeLog>