# Stockly backend — environment overrides.
# Copy to .env and load before running locally.

# JDBC connection string (matches docker-compose.yml default).
DATABASE_URL=jdbc:postgresql://localhost:5432/stockly
DATABASE_USERNAME=stockly
DATABASE_PASSWORD=stockly_dev

# Redis connection (host:port). Spring uses REDIS_HOST + REDIS_PORT internally.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT signing secret. MUST be >= 32 bytes (256 bits) for HS256.
# Generate locally with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-in-prod-min-256-bits-long-please-do-not-use-this

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Server port.
SERVER_PORT=8080