{
  "name": "@stockly/web",
  "version": "0.1.0",
  "private": true,
  "description": "Stockly web — Next.js 15 App Router frontend (es-CO/en, Mantine v7, JWT auth, RHF + Zod, TanStack Query v5, Zustand).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "clean": "rm -rf .next .turbo out coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@mantine/core": "^7.13.4",
    "@mantine/dates": "^7.13.4",
    "@mantine/form": "^7.13.4",
    "@mantine/hooks": "^7.13.4",
    "@mantine/modals": "^7.13.4",
    "@mantine/notifications": "^7.13.4",
    "@stockly/shared": "workspace:*",
    "@tabler/icons-react": "^3.21.0",
    "@tanstack/react-query": "^5.59.16",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "mantine-datatable": "^7.14.5",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^20.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}