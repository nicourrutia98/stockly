# Stockly web — public environment variables.
# Copy to .env.local for local development.

# Base URL for the Spring Boot REST API. Exposed to the browser (prefix NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Default locale. One of: es-CO, en.
NEXT_PUBLIC_DEFAULT_LOCALE=es-CO

# Default display currency for product prices. One of: USD, COP.
NEXT_PUBLIC_DEFAULT_CURRENCY=COP

# Public app version (shown in footer + telemetry).
NEXT_PUBLIC_APP_VERSION=0.1.0