# Stop pnpm from auto-installing optional peer dependencies.
#
# Why: Vitest declares happy-dom as an OPTIONAL peer, so pnpm silently installed it.
# This project never uses it — apps/web/vitest.config.ts sets `environment: 'node'`.
# Being in the tree dragged in a critical advisory (GHSA happy-dom VM context escape)
# for a package that is never loaded.
#
# Audit trail: docs/06-seguridad-dependencias.md
auto-install-peers=false